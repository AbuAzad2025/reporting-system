SECRET_KEY=change-me-to-a-long-random-string
# Local production (PostgreSQL) — create DB first, then migrate + seed:
DATABASE_URL=postgresql://postgres:123@localhost:5432/azadexa
USE_CLOUD_DB=1
FLASK_ENV=development
PORT=5000
# ---------------------------------------------------------------------------
# Fallback for offline dev without PostgreSQL (leave commented normally):
# DATABASE_URL=sqlite:///instance/reports.db
# ---------------------------------------------------------------------------
# Run:
#   python setup.py            # create DB + migrate + seed + verify
#   python -m flask run        # start the local server (:5000)
# Tests (default, isolated SQLite):  python -m pytest
# Tests (against local PostgreSQL):  set TEST_DATABASE_URL=postgresql://postgres:123@localhost:5432/azadexa_test && python -m pytest -n0
