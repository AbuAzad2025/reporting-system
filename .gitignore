__pycache__/
# npm dependencies are installed from package-lock.json, which is committed
# because CI runs `npm ci` and requires it.
node_modules/
*.pyc
instance/*.db
fonts/*.ttf
.env
venv/
.venv/
# test-generated backup artifacts (BACKUP_LOCAL_DIR default)
app/backups/
uploads/
htmlcov/
coverage.xml
# local coverage data files (the binary one pytest-cov writes per run)
.coverage
.coverage.*
bandit-security-report.*
