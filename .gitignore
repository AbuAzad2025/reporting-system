__pycache__/
# npm dependencies are installed from package-lock.json, which is committed
# because CI runs `npm ci` and requires it.
node_modules/
# fonts/*.ttf is deliberately NOT ignored. Amiri (SIL OFL 1.1) is committed
# with its licence because PDF generation downloads it on first use, and a
# field deployment on a restricted network cannot reach GitHub. When the
# download fails the font falls back to Helvetica, which has no Arabic glyphs,
# so every Arabic report renders blank - silently, at debug log level.
*.pyc
instance/*.db
.env
venv/
.venv/
# test-generated backup artifacts (BACKUP_LOCAL_DIR default)
app/backups/
uploads/
htmlcov/
coverage.xml
# local coverage data files (the binary one pytest-cov writes per run)
.coverage
.coverage.*
bandit-security-report.*

# Real business documents, not source. The Word/Excel exports this app produces
# (IPC, Variation Orders, Handover) are client contracts and tender submissions,
# and a developer will eventually save one in the working directory. This
# repository is public, so anything committed here is published permanently -
# and a blob stays in the history even after the file is deleted. Keep these
# out of git; store them in the instance/ or uploads/ directories instead.
*.docx
*.xlsx
*.xls
*.pdf
